PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loyalty_saas
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d
APP_BASE_URL=http://localhost:4000

# URL du frontend (SPA) — e-mails /card/... et redirections Stripe après Checkout (obligatoire en prod HTTPS, pas localhost)
PUBLIC_FRONTEND_URL=http://localhost:5173

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# Email notifications (MVP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_user
SMTP_PASS=your_pass
SMTP_FROM="Loyalty App <no-reply@loyalty.local>"

# Google OAuth (merchant Gmail connection)
GOOGLE_MAIL_CLIENT_ID=your_google_client_id
GOOGLE_MAIL_CLIENT_SECRET=your_google_client_secret
GOOGLE_MAIL_REDIRECT_URI=https://your-api-domain.com/api/settings/google/callback

# Review request notification (first QR visit)
REVIEW_REQUEST_DELAY_MINUTES=1
REVIEW_DEFAULT_URL=https://www.google.com/maps

# Apple Wallet certificates (production setup)
APPLE_WALLET_PASSPHRASE=your_cert_passphrase
APPLE_WALLET_WWDR_PATH=../wallet/certs/AppleWWDRCAG4.pem
APPLE_WALLET_SIGNER_CERT_PATH=../wallet/certs/signerCert.pem
APPLE_WALLET_SIGNER_KEY_PATH=../wallet/certs/signerKey.pem
APPLE_WALLET_PASS_TYPE_IDENTIFIER=pass.com.yourcompany.loyalty
APPLE_WALLET_TEAM_IDENTIFIER=YOUR_TEAM_IDENTIFIER

# Google Wallet production setup
GOOGLE_WALLET_ISSUER_ID=YOUR_ISSUER_ID
GOOGLE_WALLET_CLASS_SUFFIX=loyalty_class

# Stripe Billing (auto activation after payment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
